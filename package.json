{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/jegz-pos dev",
    "build": "pnpm run build:web",
    "build:web": "pnpm --filter @workspace/jegz-pos build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "cross-env": "^7.0.3",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
